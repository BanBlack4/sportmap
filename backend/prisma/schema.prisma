generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Club {
  id          Int      @id @default(autoincrement())
  name        String
  sport       String
  address     String
  latitude    Float
  longitude   Float
  phone       String?
  email       String?
  website     String?
  description String?
  imageUrl    String?
  schedule    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}